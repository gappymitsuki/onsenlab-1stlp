# ─── Email automation (Resend) ──────────────────────────────────────────────
# All three are optional in local dev — when missing the API routes log
# warnings and return ok without sending. Set them in Cloudflare Pages
# project settings → Environment variables for production.

# Resend API key. Reuse the Gappy Stay key, or create a new one at
# https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Audience UUID. Create "onsen-labo-waitlist" at
# https://resend.com/audiences → grab the UUID from the URL.
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Shared secret for the /api/cron/launch-reminder route. Required only
# when CRON_SECRET is set on the server — when unset, the route is
# unauthenticated (fine for local). Generate with:
#   openssl rand -hex 32
CRON_SECRET=replace-with-random-hex

# ─── Site URL used in email links ───────────────────────────────────────────
# Used by the templates to build the CTA and unsubscribe URLs. Leave
# empty in local; Cloudflare Pages should set this to the production
# domain (onsenlab-1stlp.pages.dev or the custom domain when wired).
NEXT_PUBLIC_SITE_URL=https://onsenlab-1stlp.pages.dev

# ─── Launch date used by Email 2 (informational, not yet read) ──────────────
LAUNCH_DATE=2026-07-01

# ─── Google Sheets webhook (Apps Script) ────────────────────────────────────
# Server-side only — NOT prefixed NEXT_PUBLIC_ so the URL stays out of the
# client bundle. Set up per docs/SHEETS.md. Both API routes call this in
# parallel with Resend; missing env makes the helper no-op + warn.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
